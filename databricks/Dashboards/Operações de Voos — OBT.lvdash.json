{
  "datasets": [
    {
      "name": "obt_voos",
      "displayName": "OBT Voos",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  mizukiairflows.gold.obt_voos"
      ],
      "columns": [
        {
          "displayName": "total_voos",
          "description": "Total de voos",
          "expression": "COUNT(*)"
        },
        {
          "displayName": "voos_realizados",
          "description": "Voos realizados",
          "expression": "SUM(CASE WHEN `flag_realizado` THEN 1 ELSE 0 END)"
        },
        {
          "displayName": "voos_cancelados",
          "description": "Voos cancelados",
          "expression": "SUM(CASE WHEN `flag_cancelado` THEN 1 ELSE 0 END)"
        },
        {
          "displayName": "taxa_pontualidade",
          "description": "Taxa de pontualidade (OTP) — pct voos com atraso <= 15 min",
          "expression": "ROUND(100.0 * SUM(CASE WHEN `partida_pontual` THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN `flag_realizado` THEN 1 ELSE 0 END), 0), 1)"
        },
        {
          "displayName": "serie",
          "description": "Serie para grafico de evolucao: Realizados vs Cancelados",
          "expression": "CASE WHEN `flag_realizado` THEN 'Realizados' WHEN `flag_cancelado` THEN 'Cancelados' ELSE 'Outros' END"
        }
      ]
    }
  ],
